{
  "name": "observability-replay",
  "version": "0.1.0",
  "description": "Animated incident replay over any observability backend, as an MCP server",
  "main": "dist/server.js",
  "scripts": {
    "test": "npm run build && tsx --test test/*.test.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc",
    "start": "node dist/server.js",
    "benchmark": "node dist/bench.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "observability-replay": "dist/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "files": [
    "dist/server.js",
    "dist/lib.js",
    "dist/bench.js",
    "dist/replay.html",
    "dist/apps.html",
    "dist/benchmark.html",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ALIBCJH/observability-replay.git"
  },
  "bugs": {
    "url": "https://github.com/ALIBCJH/observability-replay/issues"
  },
  "homepage": "https://github.com/ALIBCJH/observability-replay#readme"
}
